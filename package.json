{
  "name": "parar-pujo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:full": "npm run build && wrangler d1 migrations apply parar-pujo --local && wrangler dev",
    "build": "node scripts/og.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc -p worker/tsconfig.json",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "deploy": "npm run build && wrangler d1 migrations apply parar-pujo --remote && wrangler deploy",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@fontsource/anek-bangla": "^5.3.0",
    "@fontsource/atma": "^5.3.0",
    "@fontsource/baloo-da-2": "^5.3.0",
    "@fontsource/galada": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/mina": "^5.3.0",
    "@fontsource/noto-serif-bengali": "^5.3.0",
    "@fontsource/tiro-bangla": "^5.3.0",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@napi-rs/canvas": "^1.0.11",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.1"
  }
}
