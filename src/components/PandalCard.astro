---
import type { Pandal } from '../data/pandals';
import { palettes } from '../data/palettes';
import { toBnDigits } from '../lib/bangla';
import Frame from './Frame.astro';
import VisitButton from './VisitButton.astro';
import CrowdMeter from './CrowdMeter.astro';

interface Props {
  pandal: Pandal;
  index: number;
}

const { pandal, index } = Astro.props;
const p = palettes[pandal.palette];
const layouts = ['left', 'right', 'center'] as const;
const layout = layouts[index % 3];
const tilt = [-1.5, 2, -0.5, 1.2, -2.2, 0.8, 1.6][index % 7];
// Square-ish frames read better a little narrower
const frameMax = pandal.frame === 'alpona' ? 400 : pandal.frame === 'pujabarshiki' || pandal.frame === 'stamp' ? 360 : 420;
---

<article class={`card card--${layout}`} id={pandal.slug} style={`--soft:${p.soft};--accent:${p.bg};--deep:${p.deep};--tilt:${tilt}deg;--frame-max:${frameMax}px`}>
  <a class="card__frame" href={`/pandal/${pandal.slug}`} aria-label={`${pandal.nameBn} — বিস্তারিত`}>
    <span class="card__blob" aria-hidden="true"></span>
    <Frame pandal={pandal} seed={index} />
  </a>

  <div class="card__note">
    <span class="card__num" aria-hidden="true">{toBnDigits(index + 1)}</span>
    {pandal.sample && <span class="card__sample">নমুনা · sample</span>}
    <h3 class="card__name">{pandal.nameBn}</h3>
    <p class="en card__name-en">{pandal.nameEn}{pandal.since && ` · since ${pandal.since}`}</p>
    {
      pandal.themeBn && (
        <p class="card__theme">
          <span class="card__label">থিম</span> {pandal.themeBn}
          {pandal.themeEn && <span class="en"> — {pandal.themeEn}</span>}
        </p>
      )
    }
    {pandal.storyBn && <p class="card__story">{pandal.storyBn}</p>}
    <div class="card__actions">
      <VisitButton slug={pandal.slug} />
      {
        pandal.mapUrl && (
          <a class="btn btn--yellow" href={pandal.mapUrl} target="_blank" rel="noopener">
            যাব কীভাবে?
          </a>
        )
      }
      <a class="card__more" href={`/pandal/${pandal.slug}`}>সব ছবি →</a>
    </div>
    <CrowdMeter slug={pandal.slug} />
  </div>
</article>

<style>
  .card {
    display: grid;
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
    padding-block: clamp(36px, 7vw, 72px);
  }

  .card__frame {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
    width: 100%;
    max-width: var(--frame-max);
    margin-inline: auto;
    transform: rotate(var(--tilt));
    transition: transform 0.25s;
  }

  .card__frame:hover {
    transform: rotate(0) scale(1.02);
  }

  /* soft painted blob behind each frame, in that pandal's colour */
  .card__blob {
    position: absolute;
    inset: -8% -10%;
    z-index: -1;
    background: var(--soft);
    opacity: 0.55;
    border-radius: 46% 54% 42% 58% / 55% 45% 55% 45%;
  }

  .card__note {
    position: relative;
    max-width: 460px;
    margin-inline: auto;
  }

  .card__num {
    position: absolute;
    top: -0.55em;
    left: -0.2em;
    z-index: -1;
    font-family: var(--font-sign);
    font-size: 7rem;
    line-height: 1;
    color: var(--soft);
    opacity: 0.8;
  }

  .card__sample {
    display: inline-block;
    margin-bottom: 6px;
    padding: 0 8px;
    border: 1.5px dashed var(--ink-soft);
    border-radius: 4px;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  .card__name {
    font-family: var(--font-sign);
    font-size: clamp(2rem, 6vw, 2.8rem);
    color: var(--deep);
  }

  .card__name-en {
    margin: 2px 0 12px;
  }

  .card__label {
    display: inline-block;
    padding: 0 8px;
    margin-right: 4px;
    background: var(--accent);
    color: #fffaf0;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 3px;
    vertical-align: 2px;
  }

  .card__theme {
    margin: 0 0 8px;
    font-family: var(--font-serif);
    font-size: 1.2rem;
  }

  .card__story {
    margin: 0 0 8px;
    font-family: var(--font-serif);
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 14px;
    margin-top: 18px;
  }

  .card__more {
    font-weight: 600;
    color: var(--deep);
  }

  /* centre layout: the note is a taped paper slip under the frame */
  .card--center .card__note {
    padding: 22px 22px 20px;
    background: var(--kash);
    border: 1.5px solid var(--paper-deep);
    box-shadow: 0 6px 18px rgb(43 26 16 / 0.12);
    transform: rotate(calc(var(--tilt) * -1));
    text-align: center;
  }

  .card--center .card__note::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 50%;
    width: 90px;
    height: 24px;
    translate: -50% 0;
    rotate: -3deg;
    background: rgb(239 177 40 / 0.55);
  }

  .card--center .card__actions {
    justify-content: center;
  }

  .card--center .card__num {
    left: 50%;
    translate: -50% 0;
  }

  @media (min-width: 760px) {
    .card--left {
      grid-template-columns: 1.1fr 1fr;
    }

    .card--right {
      grid-template-columns: 1fr 1.1fr;
    }

    .card--right .card__frame {
      order: 2;
    }

    .card--left .card__note,
    .card--right .card__note {
      margin-inline: 0;
    }

    .card--center .card__note {
      max-width: 520px;
    }
  }
</style>
