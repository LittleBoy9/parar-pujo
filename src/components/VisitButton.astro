---
// "দেখে এলাম" — tick a pandal off in your passport. Wired up by scripts/passport.ts.
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<button class="visit btn" type="button" data-visit={slug} aria-pressed="false">
  <span class="visit__off">✓ দেখে এলাম</span>
  <span class="visit__on">দেখা হয়ে গেছে!</span>
  <svg class="visit__stamp" viewBox="0 0 60 60" aria-hidden="true">
    <circle cx="30" cy="30" r="26" fill="none" stroke="currentColor" stroke-width="3" />
    <circle cx="30" cy="30" r="20" fill="none" stroke="currentColor" stroke-width="1.5" />
    <text x="30" y="36" text-anchor="middle" font-size="16" font-family="Galada, serif" fill="currentColor">দেখা</text>
  </svg>
</button>

<style>
  .visit {
    position: relative;
  }

  .visit__on {
    display: none;
  }

  .visit[aria-pressed='true'] {
    background: var(--ink);
    color: var(--kash);
  }

  .visit[aria-pressed='true'] .visit__on {
    display: inline;
  }

  .visit[aria-pressed='true'] .visit__off {
    display: none;
  }

  .visit__stamp {
    position: absolute;
    right: -22px;
    top: -26px;
    width: 52px;
    color: var(--sindoor);
    opacity: 0;
    transform: rotate(-18deg) scale(2);
    pointer-events: none;
  }

  .visit[aria-pressed='true'] .visit__stamp {
    opacity: 0.9;
    transform: rotate(-18deg) scale(1);
  }

  .visit.just-stamped .visit__stamp {
    animation: thunk 0.35s cubic-bezier(0.3, 1.6, 0.6, 1);
  }

  @keyframes thunk {
    from {
      opacity: 0;
      transform: rotate(-30deg) scale(2.4);
    }
  }
</style>
