---
// ভিড়-মিটার: shows the crowd right now (last 45 min) and lets people at the pandal report it.
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const levels = [
  { level: 1, bn: 'ফাঁকা', emoji: '🙂' },
  { level: 2, bn: 'মাঝারি', emoji: '😅' },
  { level: 3, bn: 'ঠাসা ভিড়', emoji: '🥵' },
];
---

<div class="crowd" data-crowd={slug} hidden>
  <p class="crowd__now" data-crowd-now>
    <span class="crowd__gauge" aria-hidden="true"><i></i><i></i><i></i></span>
    <span data-crowd-text>ভিড় কেমন? এখনও কেউ বলেনি</span>
  </p>
  <div class="crowd__vote" role="group" aria-label="এখন ভিড় কেমন? — you there? tell us">
    <span class="crowd__ask">ওখানে আছেন? বলুন:</span>
    {
      levels.map((l) => (
        <button type="button" data-level={l.level} aria-pressed="false">
          <span aria-hidden="true">{l.emoji}</span> {l.bn}
        </button>
      ))
    }
  </div>
</div>

<script>
  import { CROWD_LABELS, getCrowd, timeAgo, voteCrowd, type CrowdLevel } from '../scripts/api';
  import { toBnDigits } from '../lib/bangla';

  const MINE_KEY = 'parar-pujo:my-crowd:v1';
  const FRESH = 45 * 60 * 1000;

  type Mine = Record<string, { level: CrowdLevel; at: number }>;
  const readMine = (): Mine => {
    try {
      return JSON.parse(localStorage.getItem(MINE_KEY) ?? '{}');
    } catch {
      return {};
    }
  };

  const meters = document.querySelectorAll<HTMLElement>('[data-crowd]');
  if (meters.length) void init();

  async function init() {
    const crowd = await getCrowd();
    if (!crowd) return; // API unreachable — leave the meters hidden

    meters.forEach((el) => {
      const slug = el.dataset.crowd!;
      const text = el.querySelector<HTMLElement>('[data-crowd-text]')!;
      const buttons = el.querySelectorAll<HTMLButtonElement>('[data-level]');

      const paint = () => {
        const r = crowd[slug];
        const mine = readMine()[slug];
        const myFresh = mine && Date.now() - mine.at < FRESH ? mine : null;
        const level = r?.level ?? myFresh?.level;
        el.dataset.level = level ? String(level) : '';
        if (r) {
          const l = CROWD_LABELS[r.level];
          text.textContent = `এখন: ${l.bn} ${l.emoji} · ${toBnDigits(r.votes)} জন বলেছেন · ${timeAgo(r.latest)}`;
        } else if (myFresh) {
          const l = CROWD_LABELS[myFresh.level];
          text.textContent = `এখন: ${l.bn} ${l.emoji} · আপনি বললেন`;
        }
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.level) === myFresh?.level)));
      };

      buttons.forEach((b) =>
        b.addEventListener('click', async () => {
          const level = Number(b.dataset.level) as CrowdLevel;
          buttons.forEach((x) => (x.disabled = true));
          try {
            await voteCrowd(slug, level);
            const mine = readMine();
            mine[slug] = { level, at: Date.now() };
            try {
              localStorage.setItem(MINE_KEY, JSON.stringify(mine));
            } catch {
              // fine — the vote still counted on the server
            }
            const r = crowd[slug];
            if (r && Date.now() - r.latest < FRESH) {
              // fold our reading into what's shown, approximately
              const avg = (r.level * r.votes + level) / (r.votes + 1);
              crowd[slug] = { level: avg < 1.67 ? 1 : avg < 2.34 ? 2 : 3, votes: r.votes + 1, latest: Date.now() };
            } else {
              crowd[slug] = { level, votes: 1, latest: Date.now() };
            }
            paint();
          } catch (err) {
            text.textContent = (err as Error).message;
          } finally {
            buttons.forEach((x) => (x.disabled = false));
          }
        }),
      );

      paint();
      el.hidden = false;
    });
  }
</script>

<style>
  .crowd {
    margin-top: 16px;
    padding: 10px 12px;
    border: 1.5px solid var(--ink);
    border-radius: 12px;
    background: var(--kash);
    background: color-mix(in srgb, var(--kash) 85%, transparent);
    font-size: 0.92rem;
  }

  .crowd__now {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-weight: 600;
  }

  /* three-bar gauge, filled by level */
  .crowd__gauge {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 16px;
  }

  .crowd__gauge i {
    width: 5px;
    border-radius: 1px;
    background: #d8ccb8;
  }

  .crowd__gauge i:nth-child(1) {
    height: 6px;
  }
  .crowd__gauge i:nth-child(2) {
    height: 11px;
  }
  .crowd__gauge i:nth-child(3) {
    height: 16px;
  }

  .crowd[data-level='1'] .crowd__gauge i:nth-child(-n + 1) {
    background: #3f8f4f;
  }
  .crowd[data-level='2'] .crowd__gauge i:nth-child(-n + 2) {
    background: #d9901a;
  }
  .crowd[data-level='3'] .crowd__gauge i {
    background: #c0281f;
  }

  .crowd__vote {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-top: 8px;
  }

  .crowd__ask {
    grid-column: 1 / -1;
    color: var(--ink-soft);
  }

  .crowd__vote button {
    min-height: 40px;
    padding: 0.2em 0.4em;
    white-space: nowrap;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .crowd__vote button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--kash);
  }
</style>
