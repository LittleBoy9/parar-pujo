---
// Hand-drawn, not-to-scale map of the para (no river — it's an inland para). Pins follow the road in the order pandals
// are listed in data/pandals.ts, so that order doubles as the suggested hopping route.
import { pandals } from '../data/pandals';
import { palettes } from '../data/palettes';
import { toBnDigits } from '../lib/bangla';
import { catmullRom, catmullRomPath, type Pt } from '../lib/spline';

const road: Pt[] = [
  [40, 36],
  [150, 96],
  [96, 200],
  [214, 262],
  [140, 360],
  [252, 438],
  [160, 532],
  [236, 604],
];
const roadPath = catmullRomPath(road);

const n = pandals.length;
const pins = pandals.map((p, i) => {
  const [x, y] = catmullRom(road, n === 1 ? 0.5 : 0.06 + (i / (n - 1)) * 0.88);
  // labels go on whichever side has more room (river is on the right)
  const labelLeft = x > 175;
  return { p, x, y, labelLeft, color: palettes[p.palette].bg };
});

const houses: Pt[] = [
  [30, 110], [60, 290], [20, 420], [96, 470], [292, 170], [290, 330], [44, 560], [270, 540],
  [352, 60], [366, 250], [344, 400], [362, 590],
];
const trees: Pt[] = [
  [110, 50], [226, 52], [36, 230], [180, 180], [300, 236], [70, 360], [210, 340], [120, 600], [300, 470],
  [372, 150], [340, 330], [376, 470], [330, 620],
];
---

<figure class="map">
  <svg viewBox="0 0 400 640" class="map__svg" role="img" aria-labelledby="map-title">
    <title id="map-title">পাড়ার ম্যাপ — hand-drawn map of the pandals along the road</title>
    <defs>
      <pattern id="map-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="#2b1a10" stroke-width=".6" opacity=".25" />
      </pattern>
    </defs>

    <rect width="400" height="640" fill="#f6e9cf" />
    <rect width="400" height="640" fill="url(#map-hatch)" opacity=".5" />

    <!-- pond -->
    <ellipse cx="64" cy="166" rx="30" ry="18" fill="#9cc6cc" stroke="#2c6e7a" stroke-width="2" />
    <text x="64" y="171" class="map__tiny" text-anchor="middle">পুকুর</text>

    <!-- houses and trees -->
    {
      houses.map(([x, y]) => (
        <g transform={`translate(${x} ${y})`} stroke="#2b1a10" stroke-width="1.5">
          <rect x="-9" y="-6" width="18" height="14" fill="#fffaf0" />
          <path d="M-12,-5 L0,-15 L12,-5 Z" fill="#c0281f" />
          <rect x="-2" y="2" width="4" height="6" fill="#2b1a10" stroke="none" />
        </g>
      ))
    }
    {
      trees.map(([x, y]) => (
        <g transform={`translate(${x} ${y})`}>
          <line x1="0" y1="2" x2="0" y2="12" stroke="#5a3a1a" stroke-width="2.5" />
          <circle r="10" fill="#6f9a52" stroke="#2b1a10" stroke-width="1.5" />
        </g>
      ))
    }

    <!-- tea stall: no pandal-hopping without a bhaar of cha -->
    <g transform="translate(286 86)" stroke="#2b1a10" stroke-width="1.5">
      <path d="M-16,-8 L16,-8 L12,-16 L-12,-16 Z" fill="#efb128" />
      <rect x="-14" y="-8" width="28" height="16" fill="#fffaf0" />
      <path d="M-4,0 h8 v6 h-8 Z M4,1 q4,1 0,4" fill="#c8662e" />
    </g>
    <text x="286" y="108" class="map__tiny" text-anchor="middle">চায়ের দোকান</text>

    <!-- road -->
    <path d={roadPath} fill="none" stroke="#2b1a10" stroke-width="22" stroke-linecap="round" />
    <path d={roadPath} fill="none" stroke="#e8d8b4" stroke-width="18" stroke-linecap="round" />
    <path d={roadPath} fill="none" stroke="#b3261e" stroke-width="2.5" stroke-dasharray="7 9" class="map__route" />
    <text class="map__road">
      <textPath href="#map-road-label" startOffset="30%">অরবিন্দ রোড</textPath>
    </text>
    <path id="map-road-label" d={roadPath} fill="none" transform="translate(0 -16)" />

    <!-- pins -->
    {
      pins.map(({ p, x, y, labelLeft, color }, i) => (
        <a href={`#${p.slug}`} class="map__pin" data-pin={p.slug}>
          <g transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`}>
            <path d="M0,0 C-14,-16 -14,-36 0,-36 C14,-36 14,-16 0,0 Z" fill={color} stroke="#2b1a10" stroke-width="2" />
            <circle cy="-24" r="9" fill="#fffaf0" stroke="#2b1a10" stroke-width="1.2" />
            <text y="-19.5" text-anchor="middle" class="map__num">{toBnDigits(i + 1)}</text>
            <path class="map__tick" d="M6,-38 l4,4 l8,-9" fill="none" stroke="#2c6e7a" stroke-width="3" stroke-linecap="round" />
            <text x={labelLeft ? -16 : 16} y="-20" text-anchor={labelLeft ? 'end' : 'start'} class="map__label">
              {p.nameBn}
            </text>
          </g>
        </a>
      ))
    }

    <!-- compass -->
    <g transform="translate(40 600)" stroke="#2b1a10" stroke-width="1.5">
      <circle r="16" fill="#fffaf0" />
      <path d="M0,-13 L4,0 L0,13 L-4,0 Z" fill="#b3261e" />
      <text y="-20" text-anchor="middle" class="map__tiny" stroke="none">উ</text>
    </g>
  </svg>
  <figcaption class="map__cap">
    হাতে আঁকা ম্যাপ, মাপে নয় — নম্বর ধরে ঘুরলেই সব ঠাকুর দেখা হয়ে যাবে।
    <span class="en">Not to scale — follow the numbers. Tap a pin to jump to that pandal.</span>
  </figcaption>
</figure>

<script>
  import { CHANGE_EVENT, getVisits, type Visits } from '../scripts/passport';

  const paint = (v: Visits) =>
    document.querySelectorAll<SVGAElement>('[data-pin]').forEach((pin) => {
      pin.classList.toggle('is-seen', Boolean(v[pin.dataset.pin!]));
    });
  paint(getVisits());
  window.addEventListener(CHANGE_EVENT, (e) => paint((e as CustomEvent<Visits>).detail));
</script>

<style>
  .map {
    margin: 28px auto 0;
    max-width: 520px;
  }

  .map__svg {
    display: block;
    width: 100%;
    height: auto;
    border: 3px solid var(--ink);
    border-radius: 6px;
    box-shadow: 6px 6px 0 var(--ink);
    rotate: -0.6deg;
  }

  .map__road {
    font-family: var(--font-serif);
    font-size: 13px;
    fill: #2b1a10;
  }

  .map__tiny {
    font-family: var(--font-ui);
    font-size: 10px;
    fill: #2b1a10;
  }

  .map__num {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 13px;
    fill: #2b1a10;
  }

  .map__label {
    font-family: var(--font-sign);
    font-size: 15px;
    fill: #2b1a10;
    paint-order: stroke;
    stroke: #f6e9cf;
    stroke-width: 4px;
  }

  .map__route {
    animation: march 1.2s linear infinite;
  }

  @keyframes march {
    to {
      stroke-dashoffset: -16;
    }
  }

  .map__pin g {
    transition: transform 0.15s;
  }

  .map__pin:hover path:first-child {
    stroke-width: 3;
  }

  .map__tick {
    display: none;
  }

  .map__pin.is-seen .map__tick {
    display: inline;
  }

  .map__cap {
    margin-top: 16px;
    text-align: center;
    font-family: var(--font-serif);
  }

  .map__cap .en {
    display: block;
    font-size: 0.9rem;
  }
</style>
