---
// WhatsApp first — that's where para news actually travels.
interface Props {
  text: string;
  /** the same message for visitors who switched to English */
  textEn?: string;
}

const { text, textEn } = Astro.props;
---

<div class="share" data-share-text={text} data-share-text-en={textEn}>
  <span class="share__label" data-en="Spread the word:">পাড়ায় ছড়িয়ে দিন:</span>
  <a class="share__btn share__btn--wa" data-share-wa href="https://wa.me/" target="_blank" rel="noopener">WhatsApp</a>
  <button class="share__btn" type="button" data-share-native hidden data-en="Share">শেয়ার</button>
  <button class="share__btn" type="button" data-share-copy data-en="Copy link">লিংক কপি</button>
</div>

<script>
  import { tr } from '../lib/i18n';

  document.querySelectorAll<HTMLElement>('[data-share-text]').forEach((box) => {
    const url = location.href.split('#')[0];
    const text = tr(box.dataset.shareText!, box.dataset.shareTextEn ?? box.dataset.shareText!);
    const wa = box.querySelector<HTMLAnchorElement>('[data-share-wa]')!;
    wa.href = `https://wa.me/?text=${encodeURIComponent(`${text}\n${url}`)}`;

    const native = box.querySelector<HTMLButtonElement>('[data-share-native]')!;
    if ('share' in navigator) {
      native.hidden = false;
      native.addEventListener('click', () => navigator.share({ title: text, url }).catch(() => {}));
    }

    const copy = box.querySelector<HTMLButtonElement>('[data-share-copy]')!;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copy.textContent = tr('কপি হয়েছে ✓', 'Copied ✓');
      } catch {
        copy.textContent = url;
      }
    });
  });
</script>

<style>
  .share {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
    gap: 8px;
  }

  .share__label {
    grid-column: 1 / -1;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .share__btn {
    display: grid;
    place-items: center;
    min-height: 42px;
    padding: 0.3em 0.6em;
    text-align: center;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .share__btn--wa {
    background: #25d366;
    border-color: #128c4a;
    color: #06341b;
  }
</style>
