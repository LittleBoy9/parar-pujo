---
// The real photo if there is one, otherwise the drawn placeholder.
import type { Pandal } from '../data/pandals';
import { palettes } from '../data/palettes';
import PandalArt from './PandalArt.astro';

interface Props {
  pandal: Pandal;
  src?: string; // defaults to the cover photo
  seed?: number;
  eager?: boolean;
}

const { pandal, src = pandal.photos[0], seed = 0, eager = false } = Astro.props;
---

{
  src ? (
    <img
      class="photo"
      src={src}
      alt={`${pandal.nameBn} — ${pandal.nameEn}`}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      style={src === pandal.photos[0] && pandal.focus ? `object-position:${pandal.focus}` : undefined}
    />
  ) : (
    <PandalArt palette={palettes[pandal.palette]} seed={seed} />
  )
}

<style>
  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
