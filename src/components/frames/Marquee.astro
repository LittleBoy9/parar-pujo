---
// Hand-painted cinema-hall signboard ringed with chasing bulbs. "সপরিবারে দেখুন!"
import type { Pandal } from '../../data/pandals';
import { palettes } from '../../data/palettes';
import Photo from '../Photo.astro';

interface Props {
  pandal: Pandal;
  seed?: number;
  eager?: boolean;
}

const { pandal, seed = 0, eager } = Astro.props;
const p = palettes[pandal.palette];

const bulbs: { x: number; y: number }[] = [];
const edge = (x1: number, y1: number, x2: number, y2: number, n: number) => {
  for (let i = 0; i < n; i++) bulbs.push({ x: x1 + ((x2 - x1) * i) / n, y: y1 + ((y2 - y1) * i) / n });
};
edge(18, 18, 382, 18, 12);
edge(382, 18, 382, 482, 15);
edge(382, 482, 18, 482, 12);
edge(18, 482, 18, 18, 15);
---

<div class="marquee" style={`--bg:${p.bg};--ink:${p.ink};--accent:${p.accent};--deep:${p.deep};--soft:${p.soft}`}>
  <div class="marquee__head">
    <span class="marquee__kicker">এ বছরের সেরা আকর্ষণ</span>
    <span class="marquee__name">{pandal.nameBn}</span>
  </div>
  <div class="marquee__window">
    <Photo pandal={pandal} seed={seed} eager={eager} />
  </div>
  <div class="marquee__foot">সপরিবারে দেখুন!</div>

  <svg class="marquee__bulbs" viewBox="0 0 400 500" aria-hidden="true">
    {bulbs.map((b, i) => <circle cx={b.x} cy={b.y} r="7" class={i % 2 ? 'odd' : 'even'} />)}
  </svg>
</div>

<style>
  .marquee {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 3%;
    aspect-ratio: 4 / 5;
    width: 100%;
    padding: 10% 10% 9%;
    background: var(--bg);
    background:
      radial-gradient(ellipse at 50% 30%, color-mix(in srgb, var(--soft) 60%, transparent), transparent 70%),
      var(--bg);
    border: 10px solid var(--deep);
    border-radius: 6px;
    outline: 3px solid var(--accent);
    outline-offset: -20px;
    color: var(--ink);
    container-type: inline-size;
  }

  .marquee__head {
    display: grid;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .marquee__kicker {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 12.5px;
    font-size: 3.8cqi;
    letter-spacing: 0.08em;
    color: var(--ink);
    opacity: 0.85;
  }

  .marquee__name {
    font-family: var(--font-sign);
    font-size: 33.0px;
    font-size: 10cqi;
    line-height: 1.1;
    color: var(--accent);
    /* painted 3D letters */
    text-shadow:
      1px 1px 0 var(--deep),
      2px 2px 0 var(--deep),
      3px 3px 0 #e8644f,
      4px 4px 0 #e8644f;
  }

  .marquee__window {
    min-height: 0;
    overflow: hidden;
    border: 4px solid var(--accent);
    border-radius: 4px;
    box-shadow: 0 0 0 3px var(--deep);
  }

  .marquee__foot {
    justify-self: center;
    padding: 0.2em 1em;
    background: #e8644f;
    color: #fffaf0;
    font-family: var(--font-sign);
    font-size: 19.8px;
    font-size: 6cqi;
    transform: rotate(-3deg);
    box-shadow: 3px 3px 0 var(--deep);
  }

  .marquee__bulbs {
    position: absolute;
    inset: -10px;
    width: calc(100% + 20px);
    height: calc(100% + 20px);
    pointer-events: none;
  }

  .marquee__bulbs circle {
    fill: #ffe9a8;
    stroke: var(--deep);
    stroke-width: 1.5;
    filter: drop-shadow(0 0 4px #ffd36b);
    animation: chase 1s steps(1) infinite;
  }

  .marquee__bulbs .odd {
    animation-delay: 0.5s;
  }

  @keyframes chase {
    50% {
      fill: #7a5a2a;
      filter: none;
    }
  }
</style>
