---
// A postage stamp from "Parar Dak", cancelled with a Parar Pujo Sharadiya postmark.
import type { Pandal } from '../../data/pandals';
import { palettes } from '../../data/palettes';
import { toBnDigits } from '../../lib/bangla';
import Photo from '../Photo.astro';

interface Props {
  pandal: Pandal;
  seed?: number;
  eager?: boolean;
}

const { pandal, seed = 0, eager } = Astro.props;
const p = palettes[pandal.palette];
const value = [5, 10, 15, 25, 50][seed % 5];
const ringId = `postmark-${pandal.slug}`;
---

<div class="stamp" style={`--bg:${p.bg};--ink:${p.ink};--accent:${p.accent};--deep:${p.deep};--soft:${p.soft}`}>
  <div class="stamp__inner">
    <div class="stamp__top">
      <span>পাড়ার ডাক</span>
      <span class="stamp__en">PARAR DAK</span>
    </div>
    <div class="stamp__window">
      <Photo pandal={pandal} seed={seed} eager={eager} />
    </div>
    <div class="stamp__bottom">
      <span class="stamp__value">{toBnDigits(value)}<small>পয়সা</small></span>
      <span class="stamp__name" data-en={pandal.nameEn}>{pandal.nameBn}</span>
    </div>
  </div>

  <svg class="stamp__postmark" viewBox="0 0 200 120" aria-hidden="true">
    <defs>
      <path id={ringId} d="M60,60 m-40,0 a40,40 0 1,1 80,0 a40,40 0 1,1 -80,0" />
    </defs>
    <circle cx="60" cy="60" r="50" fill="none" stroke="currentColor" stroke-width="2.5" />
    <circle cx="60" cy="60" r="30" fill="none" stroke="currentColor" stroke-width="1.5" />
    <text font-size="11" fill="currentColor" font-family="Hind Siliguri, sans-serif" letter-spacing="1">
      <textPath href={`#${ringId}`}>পাড়ার পুজো · শারদীয়া · ২০২৬ ·</textPath>
    </text>
    <text x="60" y="65" text-anchor="middle" font-size="13" fill="currentColor" font-family="Galada, serif">পুজো</text>
    <g fill="none" stroke="currentColor" stroke-width="2.5">
      {[0, 1, 2, 3].map((i) => <path d={`M112,${36 + i * 14} q11,-7 22,0 t22,0 t22,0 t22,0`} />)}
    </g>
  </svg>
</div>

<style>
  .stamp {
    --hole: 7px;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 14px;
    /* perforations: a grid of holes; the solid inner card hides all but the edge ones */
    background: radial-gradient(circle at center, transparent var(--hole), #fffaf0 calc(var(--hole) + 0.5px)) -10px -10px / 20px 20px;
    filter: drop-shadow(3px 5px 0 rgb(43 26 16 / 0.25));
    transform: rotate(-2.5deg);
    container-type: inline-size;
  }

  .stamp__inner {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 3%;
    height: 100%;
    padding: 5%;
    background: var(--bg);
    color: var(--ink);
    border: 3px solid var(--accent);
    outline: 1px solid var(--deep);
    outline-offset: -8px;
  }

  .stamp__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-serif);
    font-size: 17.8px;
    font-size: 5.4cqi;
    color: var(--accent);
  }

  .stamp__en {
    font-family: var(--font-ui);
    font-size: 11.9px;
    font-size: 3.6cqi;
    letter-spacing: 0.25em;
  }

  .stamp__window {
    min-height: 0;
    overflow: hidden;
    border: 2px solid var(--deep);
  }

  .stamp__bottom {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 8px;
  }

  .stamp__value {
    font-family: var(--font-sign);
    font-size: 36.3px;
    font-size: 11cqi;
    line-height: 1;
    color: var(--accent);
  }

  .stamp__value small {
    font-size: 13.2px;
    font-size: 4cqi;
    margin-left: 2px;
  }

  .stamp__name {
    font-family: var(--font-serif);
    font-size: 15.8px;
    font-size: 4.8cqi;
    text-align: right;
    line-height: 1.2;
  }

  .stamp__postmark {
    position: absolute;
    top: 6%;
    right: -4%;
    width: 72%;
    color: rgb(30 30 60 / 0.6);
    transform: rotate(-16deg);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
</style>
