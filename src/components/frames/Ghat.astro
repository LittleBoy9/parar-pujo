---
// Dusk at a Ganga ghat: the pandal glows above, its reflection ripples in the Ganga.
import type { Pandal } from '../../data/pandals';
import { palettes } from '../../data/palettes';
import Photo from '../Photo.astro';

interface Props {
  pandal: Pandal;
  seed?: number;
  eager?: boolean;
}

const { pandal, seed = 0, eager } = Astro.props;
const p = palettes[pandal.palette];
const fid = `ripple-${pandal.slug}`;

const diyas = [
  { x: 92, y: 420 },
  { x: 168, y: 446 },
  { x: 250, y: 412 },
  { x: 318, y: 456 },
  { x: 214, y: 476 },
];
const steps = Array.from({ length: 6 }, (_, i) => i);
---

<div class="ghat" style={`--bg:${p.bg};--deep:${p.deep};--accent:${p.accent};--soft:${p.soft}`}>
  <svg class="ghat__sky" viewBox="0 0 400 500" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id={`${fid}-sky`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color={p.deep} />
        <stop offset=".45" stop-color={p.bg} />
        <stop offset=".62" stop-color="#f0a35a" />
      </linearGradient>
      <linearGradient id={`${fid}-water`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color={p.bg} />
        <stop offset="1" stop-color={p.deep} />
      </linearGradient>
    </defs>
    <rect width="400" height="320" fill={`url(#${fid}-sky)`} />
    <rect y="318" width="400" height="182" fill={`url(#${fid}-water)`} />
  </svg>

  <!-- the pandal and its reflection -->
  <div class="ghat__window">
    <Photo pandal={pandal} seed={seed} eager={eager} />
  </div>
  <div class="ghat__reflection" aria-hidden="true" style={`filter:url(#${fid}) blur(1px)`}>
    <Photo pandal={pandal} seed={seed} />
  </div>

  <svg class="ghat__front" viewBox="0 0 400 500" aria-hidden="true">
    <defs>
      <filter id={fid}>
        <feTurbulence type="fractalNoise" baseFrequency="0.01 0.09" numOctaves="2" seed={seed} />
        <feDisplacementMap in="SourceGraphic" scale="14" />
      </filter>
      <radialGradient id={`${fid}-flame`}>
        <stop offset="0" stop-color="#fff3b0" />
        <stop offset=".4" stop-color="#ffb347" stop-opacity=".8" />
        <stop offset="1" stop-color="#ffb347" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- shimmer lines on the water -->
    <g stroke="#fffaf0" stroke-width="2" stroke-linecap="round" opacity=".45">
      <path d="M40,340 h40 M130,352 h60 M260,338 h50 M60,388 h30 M300,380 h44 M150,404 h30" />
    </g>

    <!-- ghat steps coming down from the left -->
    <g fill={p.soft} stroke={p.deep} stroke-width="2">
      {steps.map((i) => <path d={`M0,${300 + i * 24} L${118 - i * 14},${300 + i * 24} L${110 - i * 14},${324 + i * 24} L0,${324 + i * 24} Z`} />)}
    </g>

    <!-- little nouko (country boat) -->
    <g transform="translate(270 352)" fill={p.deep}>
      <path d="M0,10 Q50,26 100,10 L92,18 Q50,32 8,18 Z" />
      <path d="M30,10 Q50,-14 72,10 Z" opacity=".85" />
      <line x1="50" y1="-30" x2="50" y2="10" stroke={p.deep} stroke-width="2.5" />
    </g>

    <!-- floating diyas -->
    {
      diyas.map((d) => (
        <g transform={`translate(${d.x} ${d.y})`}>
          <circle r="22" fill={`url(#${fid}-flame)`} class="ghat__glow" />
          <path d="M-9,0 Q0,9 9,0 Z" fill="#c8662e" stroke={p.deep} stroke-width="1.5" />
          <path d="M0,-11 Q4,-4 0,0 Q-4,-4 0,-11 Z" fill="#ffd36b" />
        </g>
      ))
    }
  </svg>
</div>

<style>
  .ghat {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow: hidden;
    border-radius: 200px 200px 14px 14px / 160px 160px 14px 14px;
    border: 3px solid var(--deep);
    background: var(--deep);
  }

  .ghat__sky,
  .ghat__front {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ghat__window,
  .ghat__reflection {
    position: absolute;
    left: 18%;
    width: 64%;
    overflow: hidden;
  }

  /* pandal sits on the waterline at y=318 */
  .ghat__window {
    top: 14%;
    height: 49.6%;
    border-radius: 999px 999px 0 0;
    box-shadow: 0 0 40px 6px var(--accent);
    box-shadow: 0 0 40px 6px color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .ghat__reflection {
    top: 63.6%;
    height: 49.6%;
    /* mirrored in place, so its local top/bottom are swapped on screen */
    border-radius: 999px 999px 0 0;
    transform: scaleY(-1);
    opacity: 0.4;
    mask-image: linear-gradient(to top, #000, transparent 65%);
    -webkit-mask-image: linear-gradient(to top, #000, transparent 65%);
  }

  .ghat__glow {
    animation: flicker 2.2s ease-in-out infinite;
  }

  .ghat__front g:nth-child(odd) .ghat__glow {
    animation-delay: 0.7s;
  }

  @keyframes flicker {
    50% {
      opacity: 0.55;
    }
  }
</style>
