---
import Layout from '../layouts/Layout.astro';
---

<Layout title="রাস্তা হারিয়েছেন?" titleEn="Lost your way?" noindex>
  <section class="lost wrap">
    <p class="lost__big" data-en="Lost in the crowd?">ভিড়ে হারিয়ে গেলেন?</p>
    <p data-en="We couldn't find this page. Head home before they announce you on the mic!">এই পাতাটা খুঁজে পাওয়া গেল না। মাইকে ঘোষণা করার আগেই বাড়ি ফিরে চলুন।</p>
    <p class="en">This page got lost in the crowd.</p>
    <a class="btn btn--red" href="/" data-en="Back to Parar Pujo">পাড়ার পুজোয় ফিরুন</a>
  </section>
</Layout>

<style>
  .lost {
    padding-block: 80px 40px;
    text-align: center;
  }

  .lost__big {
    margin: 0 0 12px;
    font-family: var(--font-sign);
    font-size: clamp(2.6rem, 10vw, 4rem);
    color: var(--sindoor);
  }

  .lost .btn {
    margin-top: 20px;
  }
</style>
